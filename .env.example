# ── LLM Sağlayıcısı ────────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter

OPENAI_API_KEY=

GEMINI_API_KEY=

OPENROUTER_API_KEY=

# ── Konuşma bağlamı ───────────────────────────────────────────────────────────
# Kapalıyken cevap seçimi yalnız güncel mesajı kullanır. Açıkken sahiplik token'ı
# doğrulanan conversation'ın sınırlı geçmişi (en fazla 2 önceki kullanıcı mesajı)
# Intent Analyzer'a verilir. Internal pilot ve kod varsayılanı: true.
CHAT_CONTEXT_ENABLED=true
CHAT_CONTEXT_MAX_MESSAGES=4
CHAT_CONTEXT_MAX_CHARS=1200

# ── Academic Calendar V2 ──────────────────────────────────────────────────────
# DB SystemConfig values take precedence. Blank = the Calendar route fails closed.
# Internal pilot: 2026-2027 / GUZ. Change TERM to BAHAR when the spring term
# starts (term-less questions such as "final ne zaman" use this term) and restart.
ACADEMIC_CALENDAR_CURRENT_YEAR=2026-2027
ACADEMIC_CALENDAR_CURRENT_TERM=GUZ

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_32_CHARS
POSTGRES_DB=auzef_bot
# Docker Compose DATABASE_URL'yi yukarıdaki değerlerden üretir. Backend'i
# doğrudan çalıştıran development ortamı tek bağlantı tanımlayabilir:
# DATABASE_URL=postgresql://admin:password@localhost:5432/auzef_bot
#
# Native production'da opsiyonel olarak ayrıştırılır. Tanımlanmayan her değer
# DATABASE_URL'ye düşer; local development iki PostgreSQL gerektirmez.
# ADMIN_DATABASE_URL=postgresql://auzef_admin:password@db-admin:5432/auzef_admin
# CHAT_DATABASE_URL=postgresql://auzef_chat:password@db-chat:5432/auzef_chat

# ── pgAdmin (sadece geliştirmede kullanılır) ────────────────────────────────────
PGADMIN_EMAIL=admin@mail.com
PGADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── MeiliSearch ─────────────────────────────────────────────────────────────────
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY_32_CHARS
# Skorlar 0-1 aralığında: "90" değil "0.90". Yüzde yazılırsa hiçbir hit eşiği
# geçemez; backend bunu açılışta reddeder (services/answer_pipeline.py).
MEILI_THERESHOLD=0.90
QDRANT_THERESHOLD=0.75

# ── Admin Oturum Sistemi ─────────────────────────────────────────────────────────
# Varsayılan true (güvenli varsayılan): yönetim uçları oturum ister.
# YALNIZCA yerel geliştirmede false yapın.
ADMIN_AUTH_ENFORCED=true
# Yerel geliştirmede (http://localhost) cookie'nin çalışması için false yapın.
# Pilot/production'da true bırakın: nginx her isteği HTTPS'e yönlendirir ve
# ssl/certs/{fullchain,privkey}.pem ister (kurum içi CA ya da self-signed).
ADMIN_COOKIE_SECURE=true

# ── Çözüm Merkezi QnA Salt-Okunur API ─────────────────────────────────────
# Entegrasyon istemcisi bunu yalnız X-API-Key header'inda gönderir.
# Gerçek değeri repository'ye yazmayın.
INTEGRATION_API_KEY=

# ── Admin Girişi Kaba Kuvvet Koruması (ANALIZ.md P0-3) ──────────────────────────
# Kaç YANLIŞ parola denemesinden sonra o e-posta / IP kilitlenir. İkisi de
# gereklidir: e-posta kapsamı belirli bir hesabı hedefleyen denemeyi durdurur,
# IP kapsamı tek kaynaktan çok hesap denemesini (spray) durdurur.
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# ADMIN_LOGIN_IP_MAX_ATTEMPTS=20
# ADMIN_LOGIN_WINDOW_MIN=15

# ── Çözüm Merkezi (Talep Oluşturma) Entegrasyonu ────────────────────────────────
# base_url + service_token BOŞSA entegrasyon kapalıdır (uçlar nazik 503 döner);
# kod değişmeden .env'den açılır. Service token yalnızca backend'de kalır,
# ASLA frontend'e/loga gitmez.
CM_BASE_URL=https://service-cozummerkeziauzef.istanbul.edu.tr
CM_SERVICE_TOKEN=
# Auth header şeması: gerçek API "Api-Key <KEY>" bekliyor (OpenAPI ile doğrulandı).
# Header: "Authorization: <CM_AUTH_SCHEME> <CM_SERVICE_TOKEN>". Token'ı önek OLMADAN girin.
CM_AUTH_SCHEME=Api-Key
# channel.shortCode SPEC'te "örnek"; kesin değer netleşince burayı güncelleyin.
CM_CHANNEL_SHORTCODE=AUZEF_WEB_SAYFASI_CHATBOT
# (opsiyonel) varsayılanlar: timeout=10sn, retry=2, OTP TTL=10dk, kategori cache=900sn
# CM_TIMEOUT=10
# CM_MAX_RETRIES=2
# CM_VERIFICATION_TTL_MIN=10
# CM_CATEGORY_CACHE_TTL=900

# ── SMS Hız Sınırı (ANALIZ.md P0-1) ─────────────────────────────────────────
# send-sms ucu üç ayrı kapsamda bütçelenir. Üçü de gereklidir:
#   konuşma + IP → farklı TC'lerle yapılan NUMARALANDIRMA'yı sınırlar
#   TC           → aynı numaraya yapılan SMS BOMBARDIMANI'nı sınırlar
# (TC sayacı numaralandırmayı durdurmaz: saldırgan her TC'yi bir kez dener.)
# Bir değeri 0 yapmak o kapsamı devre dışı bırakır.
# Varsayılanlar "Dengeli" profildir; aşağıdaki satırlar yalnızca örnektir.
# CM_SMS_PER_CONVERSATION=3
# CM_SMS_CONVERSATION_WINDOW_MIN=15
# CM_SMS_PER_TC=5
# CM_SMS_TC_WINDOW_MIN=60
# CM_SMS_PER_IP=30
# CM_SMS_IP_WINDOW_MIN=60
#
# ── OTP Deneme Sayacı (ANALIZ.md P0-2) ──────────────────────────────────────
# Kaç YANLIŞ koddan sonra doğrulama oturumu iptal edilir. Eşiğe ulaşınca
# verificationToken silinir ve kullanıcı akışı baştan başlatmak zorunda kalır.
#
# Bu eşik tek başına değerlendirilmemeli: yeni SMS istemek sayacı sıfırladığı
# için gerçek bütçe yukarıdaki SMS limitiyle ÇARPILIR:
#   TC başına 5 SMS/saat × 5 deneme = saatte 25 kod denemesi
#   6 haneli kod 1.000.000 kombinasyon → beklenen kırılma süresi ~2,3 yıl
# CM_SMS_PER_TC düşürülür ya da kaldırılırsa bu koruma da zayıflar.
# CM_OTP_MAX_ATTEMPTS=5

# TC'ler sayaç tablosunda HAM saklanmaz, HMAC-SHA256 ile hash'lenir.
# Bu değişken boşsa anahtar CM_SERVICE_TOKEN'dan türetilir (önerilen).
# Doldurulacaksa TÜM worker'larda aynı olmalıdır — değiştirilirse mevcut
# sayaçlar sıfırlanmış gibi davranır.
# SC_HASH_SECRET=

# ── Diğer Ayarlar ───────────────────────────────────────────────────────────────
CIRCUIT_BREAKER_TIME=30

# ── Docker Compose proje adı ────────────────────────────────────────────────────
# Aynı makinedeki başka bir Compose projesiyle imaj/volume adı çakışmasın diye
# sabit tutun (ör. auzef-chat-analiz de bir "backend" imajı üretir).
COMPOSE_PROJECT_NAME=auzefchatbot

# ── Internal pilot (deploy/internal-pilot/pilot.env.example) ────────────────────
# docker-compose bu iki değeri bu dosyadan okur. Pilot dışı (genel) varsayılanlar:
# SELECTOR_PROMPT_VERSION=production_v2, LLM_ENABLED_DEFAULT=false.
# LLM_ENABLED_DEFAULT yalnız TAZE kurulumda SystemConfig'e yazılır; mevcut değer ezilmez.
SELECTOR_PROMPT_VERSION=variant_a_v3_contract
LLM_ENABLED_DEFAULT=true

# ── Sürüm kimliği (decision_trace'e yazılır; opsiyonel ama pilotta önerilir) ────
# GIT_SHA=<release commit, ör. git rev-parse HEAD>
# DEPLOYMENT_VERSION=internal-pilot-<tarih>

# ── Gömme (embedding) CPU iş parçacığı (opsiyonel; compose varsayılanı 8) ───────
# OMP_NUM_THREADS=8
# MKL_NUM_THREADS=8

# AUZEF_LOAD_METRICS yalnız yük testi enstrümantasyonu içindir; pilotta/production'da TANIMLAMAYIN.
