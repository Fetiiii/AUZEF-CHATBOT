# AUZEF Chatbot production backend environment template
# Copy to /etc/auzef/backend.env, replace every required/secret placeholder,
# then set owner root:auzef and mode 0640. Never commit real values.

# Required in production. Do not rely on the development DATABASE_URL fallback.
ADMIN_DATABASE_URL=
CHAT_DATABASE_URL=

# Shared search services
MEILI_URL=http://CHANGE_ME_MEILI_HOST:7700
MEILI_MASTER_KEY=
QDRANT_HOST=CHANGE_ME_QDRANT_HOST
QDRANT_PORT=6333

# Model cache is persistent and outside immutable release directories.
HF_HOME=/var/cache/auzef/huggingface

# Admin authentication. Keep secure cookies enabled for the public HTTPS site,
# including when TLS terminates at the physical Load Balancer.
ADMIN_AUTH_ENFORCED=true
ADMIN_COOKIE_SECURE=true
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_IP_MAX_ATTEMPTS=20
ADMIN_LOGIN_WINDOW_MIN=15

# Inbound, read-only Solution Center QnA API. Generate a high-entropy secret;
# send it only as X-API-Key over HTTPS and never commit the real value.
INTEGRATION_API_KEY=

# LLM provider: openrouter, openai or gemini. LLM_ENABLED remains DB-ADMIN
# SystemConfig state; keys below are runtime secrets/fallbacks.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Selector system-prompt version served by the runtime catalog.
# production_v2 = the original production prompt (public default, unchanged).
# variant_a_v1  = the Answer Pipeline V2 internal-pilot baseline.
SELECTOR_PROMPT_VERSION=production_v2

# Value seeded into SystemConfig.LLM_ENABLED on a FRESH install only; an
# existing admin-persisted value is never overwritten. Public default false.
LLM_ENABLED_DEFAULT=false

# Retrieval and request behavior (variable names match the current application).
MEILI_THERESHOLD=0.90
QDRANT_THERESHOLD=0.75
CIRCUIT_BREAKER_TIME=30
CHAT_CONTEXT_ENABLED=true
CHAT_CONTEXT_MAX_MESSAGES=4
CHAT_CONTEXT_MAX_CHARS=1200

# Academic Calendar V2 authoritative dataset policy. Keep blank until the
# corresponding current-year Calendar dataset has been reviewed/imported.
# DB SystemConfig values managed through /api/settings/calendar override these.
ACADEMIC_CALENDAR_CURRENT_YEAR=
ACADEMIC_CALENDAR_CURRENT_TERM=

# Tune thread counts to the CPU allocation of each APP node before enabling.
# OMP_NUM_THREADS=8
# MKL_NUM_THREADS=8
TOKENIZERS_PARALLELISM=true

# Solution Center integration. Leave CM_BASE_URL and CM_SERVICE_TOKEN empty only
# when this integration is intentionally disabled.
CM_BASE_URL=
CM_SERVICE_TOKEN=
CM_AUTH_SCHEME=Api-Key
CM_CHANNEL_SHORTCODE=AUZEF_WEB_SAYFASI_CHATBOT
CM_TIMEOUT=10
CM_MAX_RETRIES=2
CM_VERIFICATION_TTL_MIN=10
CM_CATEGORY_CACHE_TTL=900
SC_HASH_SECRET=
CM_SMS_PER_CONVERSATION=3
CM_SMS_CONVERSATION_WINDOW_MIN=15
CM_SMS_PER_TC=5
CM_SMS_TC_WINDOW_MIN=60
CM_SMS_PER_IP=30
CM_SMS_IP_WINDOW_MIN=60
CM_OTP_MAX_ATTEMPTS=5

# /var/lib/auzef/flags/maintenance.flag is an APP-local emergency override.
# It is not the central planned maintenance state; that state lives in DB-ADMIN.
