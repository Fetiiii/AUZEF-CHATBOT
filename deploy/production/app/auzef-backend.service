[Unit]
Description=AUZEF Chatbot FastAPI backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=auzef
Group=auzef
WorkingDirectory=/opt/auzef/current/backend
EnvironmentFile=/etc/auzef/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/auzef/current/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=auzef-backend

[Install]
WantedBy=multi-user.target
