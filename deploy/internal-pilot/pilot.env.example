# Internal pilot (INTERNAL_PILOT) — non-secret desired settings.
#
# These are the settings the internal-pilot stack must resolve for the frozen
# pilot baseline to be the behaviour actually served. Preflight reads THIS
# FILE as the desired configuration:
#
#   cd backend && python -m scripts.internal_pilot_preflight runtime
#
# Copy to deploy/internal-pilot/pilot.env and add secrets there (that file is
# not committed). NO REAL API KEY BELONGS IN THIS FILE.
#
# ⚠️ THE BACKEND CONTAINER DOES NOT READ THIS FILE.
# docker-compose's backend service uses `env_file: .env`, and compose resolves
# ${SELECTOR_PROMPT_VERSION:-...} from the shell or the project-root .env.
# Before starting the pilot stack, copy at least these two lines into the
# project-root .env (or export them), or the compose defaults win and the
# container will serve production_v2 with LLM_ENABLED seeded false:
#
#     SELECTOR_PROMPT_VERSION=variant_a_v1
#     LLM_ENABLED_DEFAULT=true
#
# Acceptance Stage A15/A16 verifies this against the running container.
#
# Freeze:      docs/answer-pipeline-v2/INTERNAL_PILOT_FREEZE.md
# Fingerprint: c7081ff54d959d183e7964498720dce7866461e72c3fa407c7346ea3cf32c5c6

# ── Selector prompt (BLOCKER-1) ───────────────────────────────────────────────
# Runtime default is production_v2 (the historical prompt, 2d59cfb6…).
# The internal pilot serves Variant A, fingerprint 1aed5688….
SELECTOR_PROMPT_VERSION=variant_a_v1

# ── Initial LLM state (BLOCKER-2) ─────────────────────────────────────────────
# Seeds SystemConfig.LLM_ENABLED on a FRESH install only. An existing value
# an admin already persisted — including an emergency "false" — is never
# overwritten. The public default stays false.
LLM_ENABLED_DEFAULT=true

# ── Provider / model identity (frozen) ────────────────────────────────────────
# OpenRouter only; no direct OpenAI/Gemini inference in the pilot.
LLM_PROVIDER=openrouter
LLM_SELECTOR_MODEL=openai/gpt-4o-mini
LLM_SELECTOR_TEMPERATURE=0
LLM_SELECTOR_MAX_TOKENS=32
LLM_INTENT_ANALYZER_MODEL=openai/gpt-4o-mini
LLM_INTENT_ANALYZER_TEMPERATURE=0
LLM_INTENT_ANALYZER_MAX_TOKENS=300

# LLM_SELECTOR_REASONING_EFFORT is deliberately NOT set.
#
# The frozen baseline is "reasoning = none" meaning the reasoning field is
# UNSET — no reasoning key is transmitted at all (capability config
# af9eb2d0…). Setting this to "none" would send reasoning.effort="none",
# a different request (config caa89baa…) that no benchmark ever measured.
# Preflight fails if this variable is set to anything.

# ── Secrets: set in pilot.env, never here ─────────────────────────────────────
# OPENROUTER_API_KEY=
# POSTGRES_PASSWORD=
# MEILI_MASTER_KEY=
